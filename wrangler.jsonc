{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rittracker",
  "compatibility_date": "2026-06-14",
    "main": "src/worker.js",

  "observability": {
    "enabled": true
  },
 "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
